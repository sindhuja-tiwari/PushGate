      "{py}",
      "producer/producer.py",
      "init",
      "--db",
      "{work}/producer.duckdb"
    ],
    [
      "{py}",
      "producer/producer.py",
      "features",
      "--db",
      "{work}/producer.duckdb",
      "--out",
      "{good}"
    ]
  ],
  "bad": [
    [
      "{py}",
      "producer/producer.py",
      "features",
      "--db",
      "{work}/producer.duckdb",
      "--out",
      "{bad}",
      "--corrupt",
      "string-weight"
    ]
  ]
