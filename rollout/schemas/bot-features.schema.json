{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pushgate.dev/schemas/bot-features-1.json",
  "title": "bot-features/1",
  "description": "What the feature file format promises. Written from the format spec, as a typical team would write it. It does not encode any consumer release's limits (feature capacity, input slots): those live in consumer code. That gap is what B1 measures.",
  "type": "object",
  "required": ["schema", "config_version", "features"],
  "properties": {
    "schema": {"const": "bot-features/1"},
    "config_version": {"type": "string", "minLength": 1},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "weight", "fields"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "weight": {"type": "number"},
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
